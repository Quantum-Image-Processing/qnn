# ─── Datasets (large; download separately — see data/*/DOWNLOAD.md) ───
data/
*.zip
*.rar
*.tar
*.tar.bz2
*.tgz

# ─── Python virtual environment ───
.venv/
venv/
env/

# ─── Python caches / build ───
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ─── Training / run artifacts (regenerable) ───
logs/
*.log
results_*/
results/

# ─── Model checkpoints (kept local only; not shared) ───
checkpoints*/
# ...except the trained pure-QNN weights: 44 KB total, and without them a
# collaborator has to retrain (~30 min) before the pipeline or demo will run.
!checkpoints_pure/
!checkpoints_pure/*.npz
!checkpoints_pure/history.json
# split.json records which scene ids are held out for evaluation - without it
# a collaborator cannot reproduce an honest train/test separation.
!checkpoints_pure/split.json

# ─── OS / editor junk ───
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ─── Secrets (never commit) ───
.env
*.pem
kaggle.json
